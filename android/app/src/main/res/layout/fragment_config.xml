<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ── Location Link Extractor Bar (WhatsApp / Google Maps) ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_color"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Location Link Extractor"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etLocationLink"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:hint="Paste WhatsApp or Google Maps link..."
                        android:textColorHint="@color/text_muted"
                        android:textColor="@color/text_primary"
                        android:background="@color/bg_input"
                        android:textSize="12sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:singleLine="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExtractLink"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="Extract"
                        android:textSize="12sp"
                        android:textColor="@color/bg_app"
                        android:layout_marginStart="6dp"
                        app:backgroundTint="@color/text_accent"
                        app:cornerRadius="6dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLinkStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Paste link with coordinates or shared WhatsApp location pin"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Profile Selection Radio Chips ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfileVltd"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="VLTD"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/bg_card"
                app:strokeColor="@color/text_accent"
                app:strokeWidth="1.5dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfileGpcb"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:text="GPCB"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                app:backgroundTint="@color/bg_card"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfileCgm"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="CGM"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                app:backgroundTint="@color/bg_card"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- ── Configuration Card (Device & Telematics Settings) ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_color"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Active Server Status Banner -->
                <TextView
                    android:id="@+id/tvServerBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Server: commonlayer.parivahan.gov.in | Primary: :9031 | Emergency: :9032"
                    android:textColor="@color/text_accent"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:background="@color/bg_input"
                    android:padding="8dp"
                    android:layout_marginBottom="10dp" />

                <!-- IMEI & Vehicle Reg -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IMEI Number"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etImei"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:text="869833088601301"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:background="@color/bg_input"
                            android:textSize="13sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:inputType="number"
                            android:maxLength="15" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/vregGroup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vehicle Reg"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etVehicleReg"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:text="GJ01AC0000"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:background="@color/bg_input"
                            android:textSize="13sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:maxLength="12" />
                    </LinearLayout>
                </LinearLayout>

                <!-- CGM HMAC Key Field -->
                <LinearLayout
                    android:id="@+id/hmacGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HMAC Key (Hex/ASCII)"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etHmacKey"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="26bcb9e368440d4a"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:background="@color/bg_input"
                        android:fontFamily="monospace"
                        android:textSize="12sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- Latitude & Longitude row -->
                <LinearLayout
                    android:id="@+id/coordsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Latitude (°N)"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etLat"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:text="21.705100"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:background="@color/bg_input"
                            android:textSize="13sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:inputType="numberDecimal" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Longitude (°E)"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etLon"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:text="72.995900"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:background="@color/bg_input"
                            android:textSize="13sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:inputType="numberDecimal" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Server & Port settings -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Target Host"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etHost"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:text="commonlayer.parivahan.gov.in"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:background="@color/bg_input"
                            android:textSize="12sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Port"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/etPort"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:text="9031"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:background="@color/bg_input"
                            android:textSize="13sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:inputType="number" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Interval -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Send Interval (s):"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/etInterval"
                        android:layout_width="70dp"
                        android:layout_height="36dp"
                        android:text="10"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:background="@color/bg_input"
                        android:textSize="13sp"
                        android:inputType="number" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Primary Simulator Actions ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_color"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Main Start / Stop Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartStop"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="▶ START SIMULATOR"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    app:backgroundTint="@color/success"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="8dp" />

                <!-- SOS Emergency Buttons (VLTD profile) -->
                <LinearLayout
                    android:id="@+id/sosButtonRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSosOn"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="🚨 SOS ON (EMR)"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        app:backgroundTint="@color/danger"
                        app:cornerRadius="8dp"
                        android:enabled="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSosOff"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="🛡️ SOS OFF (SEM)"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        app:backgroundTint="@color/stopped"
                        app:cornerRadius="8dp"
                        android:enabled="false" />
                </LinearLayout>

                <!-- Single Manual Push Grid (VLTD only) -->
                <LinearLayout
                    android:id="@+id/manualPushSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manual Packet Push (VLTD only):"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPushLgn"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="1. LGN"
                            android:textSize="10sp"
                            android:textColor="@color/text_primary"
                            app:backgroundTint="@color/bg_input"
                            app:strokeColor="@color/border_color"
                            app:strokeWidth="1dp"
                            app:cornerRadius="6dp"
                            android:layout_marginEnd="2dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPushHel"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="2. HEL"
                            android:textSize="10sp"
                            android:textColor="@color/text_primary"
                            app:backgroundTint="@color/bg_input"
                            app:strokeColor="@color/border_color"
                            app:strokeWidth="1dp"
                            app:cornerRadius="6dp"
                            android:layout_marginEnd="2dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPushPvt"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="3. PVT"
                            android:textSize="10sp"
                            android:textColor="@color/text_primary"
                            app:backgroundTint="@color/bg_input"
                            app:strokeColor="@color/border_color"
                            app:strokeWidth="1dp"
                            app:cornerRadius="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hidden fields for compatibility -->
        <EditText android:id="@+id/etAlt" android:layout_width="0dp" android:layout_height="0dp" android:text="46.0" android:visibility="gone" />
        <EditText android:id="@+id/etSpeed" android:layout_width="0dp" android:layout_height="0dp" android:text="0.0" android:visibility="gone" />
        <EditText android:id="@+id/etHeading" android:layout_width="0dp" android:layout_height="0dp" android:text="208.53" android:visibility="gone" />
        <EditText android:id="@+id/etSatellites" android:layout_width="0dp" android:layout_height="0dp" android:text="13" android:visibility="gone" />
        <EditText android:id="@+id/etOperator" android:layout_width="0dp" android:layout_height="0dp" android:text="AIRTEL" android:visibility="gone" />
        <EditText android:id="@+id/etMcc" android:layout_width="0dp" android:layout_height="0dp" android:text="404" android:visibility="gone" />
        <EditText android:id="@+id/etMnc" android:layout_width="0dp" android:layout_height="0dp" android:text="05" android:visibility="gone" />
        <EditText android:id="@+id/etCellId" android:layout_width="0dp" android:layout_height="0dp" android:text="16D5" android:visibility="gone" />
        <EditText android:id="@+id/etLac" android:layout_width="0dp" android:layout_height="0dp" android:text="56C5" android:visibility="gone" />
    </LinearLayout>
</ScrollView>

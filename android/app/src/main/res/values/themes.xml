<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Force Slate Dark theme across the entire application -->
    <style name="Theme.AIS140Simulator" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/text_accent</item>
        <item name="colorOnPrimary">@color/bg_app</item>
        <item name="colorPrimaryContainer">@color/bg_card</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <item name="colorSecondary">@color/success</item>
        <item name="colorOnSecondary">@color/bg_app</item>

        <item name="android:colorBackground">@color/bg_app</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_input</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border_color</item>

        <item name="android:statusBarColor">@color/bg_app</item>
        <item name="android:navigationBarColor">@color/bg_app</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/bg_app</item>
        
        <!-- Text color defaults -->
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <style name="Theme.AIS140Simulator.Splash" parent="Theme.AIS140Simulator">
        <item name="android:windowBackground">@color/bg_app</item>
    </style>
</resources>
